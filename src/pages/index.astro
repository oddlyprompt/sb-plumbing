---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
const services = [
  {number:'01',name:'Custom Homes & New Builds',text:'Thoughtfully planned plumbing installations for new residences, from rough-in through final fixtures.'},
  {number:'02',name:'Bathroom Renovations',text:'Complete bathroom projects with attention to shower systems, fixture selection, tile and finishing details.'},
  {number:'03',name:'Commercial & Multi-Unit',text:'Practical plumbing expertise for restaurants, commercial environments and multi-unit residential construction.'},
];
const projects = [
  {title:'Modern Bathroom Renovation',category:'Finished bathrooms',placeholder:'Feature project photo / freestanding bathtub',tone:'placeholder-warm'},
  {title:'Precision Shower Installation',category:'Custom showers',placeholder:'Feature project photo / marble shower',tone:'placeholder-light'},
  {title:'Care in Every Detail',category:'The work behind the finish',placeholder:'Feature project photo / floor-heating installation',tone:''},
];
---
<Base>
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">Ottawa · Custom Residential & Commercial</span>
      <h1 class="display">Built right.<br/><em>Finished</em><br/>beautifully.</h1>
      <p class="lead">Exceptional plumbing and complete bathroom work for custom homes, thoughtful renovations and commercial spaces.</p>
      <div class="hero-links"><a class="pill-link" href={base+'projects/'}>Explore our work <span>↗</span></a><a class="text-link" href={base+'contact/'}>Start a project</a></div>
    </div>
    <div class="hero-photo"><div class="image-placeholder"><span>Project photography coming soon</span></div><span class="hero-tag">Precision in every detail / S&B Plumbing</span></div>
  </section>
  <div class="metric-band"><span>Custom Homes & New Builds</span><span>Complete Bathroom Renovations</span><span>Commercial & Multi-Unit</span></div>
  <section class="section-pad intro-grid">
    <div class="reveal"><span class="eyebrow">A commitment to the details</span><h2 class="section-title">The work you see.<br/><em>The quality you feel.</em></h2></div>
    <div class="intro-copy reveal"><p class="lead">Great spaces begin with great workmanship. From systems hidden behind the walls to the finishing touches that bring a room together, S&B Plumbing Inc. approaches each job with care and precision.</p><p>Serving Ottawa and surrounding communities, we bring experience in custom-home construction, bathroom renovations and commercial plumbing. The result is dependable work, thoughtful execution and spaces built to be enjoyed.</p><a class="pill-link" href={base+'about/'}>More about S&B <span>↗</span></a></div>
  </section>
  <section class="section-pad services"><div class="section-top reveal"><div><span class="eyebrow">What we do</span><h2 class="section-title">Built for projects<br/><em>of every scale.</em></h2></div><p>From a refined bathroom renovation to the complete plumbing scope of a new build, we understand what it takes to get the details right.</p></div>
    <div class="service-list">{services.map(service=><div class="service-item reveal"><span class="number">{service.number}</span><div><h3>{service.name}</h3><p>{service.text}</p></div><span class="arrow">↗</span></div>)}</div>
  </section>
  <section class="section-pad"><div class="section-top reveal"><div><span class="eyebrow">Selected work</span><h2 class="section-title">Craftsmanship,<br/><em>in practice.</em></h2></div><p>A closer look at finished spaces, detailed installations and the work that brings a project to life.</p></div>
    <div class="projects-grid">{projects.map(project=><a class="project-card reveal" href={base+'projects/'}><div class="photo-panel"><div class={'image-placeholder '+project.tone}><span>{project.placeholder}</span></div></div><h3>{project.title} ↗</h3><p>{project.category}</p></a>)}</div><div class="center-cta"><a class="pill-link" href={base+'projects/'}>View all projects <span>↗</span></a></div>
  </section>
  <section class="split-feature"><div class="split-image"><div class="photo-panel"><div class="image-placeholder placeholder-light"><span>Under-construction project photo coming soon</span></div></div></div><div class="split-content"><span class="eyebrow">From rough-in to final finish</span><h2 class="section-title">The difference is<br/><em>in the details.</em></h2><p class="lead">A beautiful result depends on thoughtful work at every stage. We focus on the fundamentals behind the walls as carefully as the fixtures and finishes you'll see every day.</p><a class="pill-link" href={base+'contact/'}>Discuss your project <span>↗</span></a></div></section>
</Base>